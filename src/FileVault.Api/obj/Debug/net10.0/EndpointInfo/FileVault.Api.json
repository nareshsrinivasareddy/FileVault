{
  "openapi": "3.1.1",
  "info": {
    "title": "FileVault.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5132"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "FileVault.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/documents/upload": {
      "post": {
        "tags": [
          "FileVault.Api"
        ],
        "summary": "Upload a PDF document to Azure Blob Storage.",
        "operationId": "UploadDocument",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IFormFile": {
        "type": "string",
        "format": "binary"
      }
    }
  },
  "tags": [
    {
      "name": "FileVault.Api"
    }
  ]
}